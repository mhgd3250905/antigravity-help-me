{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mhgd3250905/antigravity-help-me/result-schema.json",
  "title": "antigravity-help-me result",
  "description": "The only accepted terminal result for one antigravity-help-me task.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_id",
    "outcome",
    "summary",
    "reason",
    "missing",
    "next_steps",
    "evidence"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 48
    },
    "outcome": {
      "type": "string",
      "enum": ["completed", "blocked"]
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "reason": {
      "type": "string",
      "maxLength": 2000
    },
    "missing": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      }
    },
    "next_steps": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      }
    },
    "verdict": {
      "type": "string",
      "enum": ["pass", "fail"]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "outcome": {"const": "blocked"}
        }
      },
      "then": {
        "properties": {
          "reason": {"minLength": 1},
          "missing": {"minItems": 1},
          "next_steps": {"minItems": 1}
        }
      }
    }
  ]
}
